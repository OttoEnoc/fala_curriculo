# Copie este arquivo como .env e preencha os valores.
# Nunca envie o .env ao Git. Aqui ficam apenas valores fictícios.

# Porta local do servidor.
PORTA=3001

# Provedor de IA: anthropic, simulado ou nenhum.
# "simulado" serve para testes locais e não usa IA.
# "nenhum" monta o currículo básico, sem melhorar a redação.
IA_PROVEDOR=nenhum
IA_API_KEY=
# Opcional. Sem valor, usa o modelo padrão do provedor.
IA_MODELO=
# Tempo máximo de espera pela IA, em milissegundos.
IA_TEMPO_LIMITE_MS=20000
