# Copie este arquivo como .env e cole as chaves. O .env nunca vai para o Git.

# Claude (texto do currículo). Chave criada em platform.claude.com > API Keys.
IA_API_KEY=
IA_MODELO=claude-haiku-5-5
IA_TEMPO_LIMITE_MS=20000

# OpenAI (transcrição da voz). Chave criada em platform.openai.com > API keys.
OPENAI_API_KEY=
TRANSCRICAO_MODELO=gpt-transcribe
# Voz do app (OpenAI). Vozes: marin, cedar, coral, nova, shimmer...
FALA_MODELO=gpt-4o-mini-tts
FALA_VOZ=marin

# Limites por IP, por hora
LIMITE_CURRICULOS_POR_HORA=5
LIMITE_AUDIOS_POR_HORA=120
LIMITE_FALAS_POR_HORA=400

PORTA=3002
