# ---------------------------------------------
# Fala Currículo — arquivos que não vão para o Git
# ---------------------------------------------

# Dependências
node_modules/
jspm_packages/
web_modules/
bower_components/

# Chaves e variáveis de ambiente
# Nunca suba o .env: é onde fica a chave da API de IA.
# O .env.exemplo sobe de propósito, para listar as variáveis sem os valores.
.env
.env.*
!.env.exemplo

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Dados de execução
pids
*.pid
*.seed
*.pid.lock

# Cobertura de testes
coverage
*.lcov
.nyc_output
lib-cov

# Caches de ferramentas
.npm
.cache
.parcel-cache
.eslintcache
.stylelintcache
.node_repl_history
*.tsbuildinfo
.pnpm-store
.yarn-integrity

# Saída de build
build/Release
dist
out
.next
.nuxt
.output
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Serviços em nuvem
.serverless/
.firebase/
.dynamodb/
.vercel

# Empacotamento
*.tgz

# Windows e OneDrive
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store

# Editores
.vscode/
.idea/
*.swp
# Cloudflare (wrangler)
.dev.vars
.dev.vars.*
!.dev.vars.exemplo
.wrangler/
.cache-fala/
